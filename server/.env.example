# BC-ASSISTANT server config. Real .env lives ONLY on the VM (chmod 600), never in git.
PORT=8100
HOST=127.0.0.1
# Origin of the GitHub Pages frontend (comma-separated if several):
CORS_ORIGINS=https://zay1d.github.io
# PostgreSQL (local):
DATABASE_URL=postgres://bcassist:CHANGE_ME@127.0.0.1:5432/bcassist
# Auth — single shared login. Hash a password with:  node src/hash.js '<password>'
AUTH_USER=summit
AUTH_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
# Long random secret for signing JWTs:
JWT_SECRET=CHANGE_ME_RANDOM
TOKEN_TTL=12h
# File storage on local disk:
FILES_DIR=/opt/bc-assistant/files
MAX_FILE_MB=25
